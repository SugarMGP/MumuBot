# Generate long random URL-safe values for both secrets before deployment.
POSTGRES_PASSWORD=
MUMU_WEB_ADMIN_KEY=

# Required model endpoints.
MUMU_MODEL_HIGH_BASE_URL=
MUMU_MODEL_HIGH_API_KEY=
MUMU_MODEL_HIGH_MODEL=
MUMU_MODEL_LOW_BASE_URL=
MUMU_MODEL_LOW_API_KEY=
MUMU_MODEL_LOW_MODEL=
MUMU_EMBEDDING_BASE_URL=
MUMU_EMBEDDING_API_KEY=
MUMU_EMBEDDING_MODEL=

# Optional when vision is disabled.
MUMU_VISION_BASE_URL=
MUMU_VISION_API_KEY=
MUMU_VISION_MODEL=

# The bundled NapCat service uses an unauthenticated internal WebSocket.
# Set both values only when connecting to an external OneBot instance.
MUMU_ONEBOT_WS_URL=
MUMU_ONEBOT_TOKEN=

# Optional deployment overrides.
MUMU_WEB_PORT=7468
NAPCAT_WEBUI_PORT=6099
POSTGRES_DB=mumu_bot
POSTGRES_USER=mumu
MUMU_CONFIG_DIR=./config
