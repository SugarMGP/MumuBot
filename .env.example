# Bootstrap secrets and infrastructure only.
# Generate long random URL-safe values for deployment secrets.
POSTGRES_PASSWORD=
MUMU_WEB_ADMIN_KEY=

# AES-256-GCM master key for model and MCP secrets in PostgreSQL.
# Generate with: openssl rand -base64 32
MUMU_SECRET_KEY=

# OneBot connection (token is generated by the bundled SnowLuma service).
MUMU_ONEBOT_WS_URL=
MUMU_ONEBOT_TOKEN=

# Direct binary runs need an explicit DSN; Compose builds it automatically.
# MUMU_DATABASE_DSN=postgres://mumu:password@127.0.0.1:5432/mumu_bot?sslmode=disable

# Optional deployment overrides.
MUMU_WEB_PORT=7468
MUMU_SERVER_PORT=7468
MUMU_ONEBOT_RECONNECT_SECONDS=5
MUMU_MEDIA_DIR=./media
MUMU_STICKER_DIR=./stickers
MUMU_LOG_LEVEL=info
MUMU_DEBUG=false

# Database and model/MCP application settings live in the admin UI.
