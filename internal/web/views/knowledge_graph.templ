package views

import (
	"fmt"
	"mumu-bot/internal/web/services"
)

type KnowledgeGraphPageData struct {
	Graph     services.GroupKnowledgeGraph
	Workspace KnowledgeWorkspaceData
	Flash     *FlashMessage
	Panel     GraphPanelData
}

templ KnowledgeGraphPage(data KnowledgeGraphPageData, currentPath string) {
	@Layout(LayoutData{Title: "统一记忆", CurrentPath: currentPath, NavItems: NavItems(), Flash: data.Flash}, KnowledgeGraphBody(data))
}

templ KnowledgeGraphBody(data KnowledgeGraphPageData) {
	<div class="admin-memory-page space-y-5">
		@KnowledgeWorkspace(data.Workspace)
		<div class="grid grid-cols-[minmax(0,1fr)_350px] gap-5 items-start">
			<section class="card admin-graph-surface overflow-hidden">
				<div class="admin-graph-toolbar flex flex-wrap items-center justify-between gap-3 px-5 pt-5"><div class="admin-graph-legend flex flex-wrap items-center gap-4 text-xs text-base-content/65"><span><i class="admin-legend-dot bg-success"></i>启用</span><span><i class="admin-legend-dot bg-base-300"></i>归档</span><span class="admin-legend-separator"></span><span class="admin-legend-line admin-legend-line--pink">记忆关系</span><span class="admin-legend-line admin-legend-line--teal">相关话题</span><span class="admin-legend-line admin-legend-line--gray">原文来源</span></div><div class="join admin-graph-controls"><button class="btn btn-ghost btn-xs join-item" type="button" data-graph-command="zoom-in" aria-label="放大图谱">+</button><button class="btn btn-ghost btn-xs join-item" type="button" data-graph-command="zoom-out" aria-label="缩小图谱">−</button><button class="btn btn-ghost btn-xs join-item" type="button" data-graph-command="reset" aria-label="重置视角">↗</button></div></div>
				if len(data.Graph.Items)+len(data.Graph.Topics)>0 {
					<div class="admin-graph-canvas h-[560px] w-full"><div class="h-full w-full" data-knowledge-graph={ groupKnowledgeGraphJSON(data) } data-graph-panel="#knowledge-graph-panel" data-graph-return={ data.Workspace.CurrentURL } role="img" aria-label="群聊记忆与话题关系图"></div></div>
				} else {
					<div class="h-[560px] grid place-content-center text-center text-base-content/50"><p class="font-medium">{ ternaryString(data.Workspace.Filter.GroupID==0,"请选择要查看的群聊","暂时没有匹配的记忆或话题") }</p><p class="mt-2 text-sm">{ ternaryString(data.Workspace.Filter.GroupID==0,"","试试其他群聊或筛选条件") }</p></div>
				}
				<div class="border-t border-base-300 px-5 py-4">
					<div class="text-sm text-base-content/60">
						记忆 { fmt.Sprint(len(data.Graph.Items)) } / { fmt.Sprint(data.Graph.KnowledgeTotal) } 条 · 话题 { fmt.Sprint(len(data.Graph.Topics)) } / { fmt.Sprint(data.Graph.TopicTotal) } 个
						if int64(len(data.Graph.Items)+len(data.Graph.Topics))<data.Graph.Total {
							<p class="mt-1 text-xs">部分节点未显示，可缩小范围或聚焦查看</p>
						}
					</div>
				</div>
				<details class="border-t border-base-300 px-5 py-3">
					<summary class="cursor-pointer text-sm">选择节点</summary>
					<div class="flex flex-wrap gap-2 pt-3">
						for _,item:=range data.Graph.Items {
							<button class="btn btn-ghost btn-xs" hx-get={ WithQuery(graphPanelURL(data.Workspace.Filter.GroupID, "knowledge", item.ID, 0), "return_to", data.Workspace.CurrentURL) } hx-target="#knowledge-graph-panel" hx-swap="innerHTML">{ knowledgeTitle(item) }</button>
						}
						for _,topic:=range data.Graph.Topics {
							<button class="btn btn-ghost btn-xs" hx-get={ WithQuery(graphPanelURL(data.Workspace.Filter.GroupID, "topic", topic.TopicID, 0), "return_to", data.Workspace.CurrentURL) } hx-target="#knowledge-graph-panel" hx-swap="innerHTML">{ graphTopicTitle(topic) }</button>
						}
					</div>
				</details>
			</section>
			<aside id="knowledge-graph-panel" class="card admin-detail-surface min-w-0" aria-live="polite">
				@KnowledgeGraphPanel(data.Panel)
			</aside>
		</div>
	</div>
}

templ KnowledgeGraphPanel(data GraphPanelData) {
	<div class="card-body p-5 gap-4 admin-detail-body" data-selected-kind={ data.NodeKind } data-selected-id={ fmt.Sprint(data.ID) } data-selected-related={ fmt.Sprint(data.Related) }>
		if data.Title=="" {
			<h2 class="font-semibold">选择一个节点或连线</h2>
			<p class="text-sm text-base-content/55 leading-6">点击图中的记忆、话题或连线查看详情。</p>
		} else {
			<div class="admin-detail-heading"><div class="flex items-center gap-2"><span class="admin-detail-dot"></span><p class="text-xs text-secondary">{ data.KindLabel }</p></div><h2 class="mt-2 text-lg font-semibold break-words">{ data.Title }</h2></div>
			if data.Status!="" {
				<span class={ memoryStatusClass(data.Status) }>{ memoryStatusText(data.Status) }</span>
			}
			if data.Content!=data.Title {
				<div class="admin-detail-quote"><p class="text-sm leading-7 whitespace-pre-wrap break-words">{ data.Content }</p></div>
			}
			if data.ActionKind!="" {
				@KnowledgeStatusForm(data.ActionKind, data.ID, data.Status, data.ReturnTo)
			}
			if data.DetailURL!="" {
				<a class="link link-primary text-sm" href={ templ.SafeURL(data.DetailURL) }>查看完整详情</a>
			}
			if data.FocusURL!="" {
				<div class="admin-detail-section"><div class="flex items-center justify-between"><h3 class="text-sm font-semibold">相关记忆</h3><span class="text-xs text-base-content/45"></span></div><a class="btn btn-soft btn-sm mt-3 w-full" href={ templ.SafeURL(data.FocusURL) }>聚焦关联</a></div>
			}
			<h3 class="admin-detail-section border-t border-base-300 pt-4 font-semibold text-sm">原文依据</h3>
			@KnowledgeEvidenceGroups(data.Evidence, nil, data.ReturnTo)
			<div class="flex justify-between">
				if data.PreviousURL!="" {
					<button class="btn btn-ghost btn-sm" hx-get={ data.PreviousURL } hx-target="#knowledge-graph-panel" hx-swap="innerHTML">上一页</button>
				}
				if data.NextURL!="" {
					<button class="btn btn-ghost btn-sm" hx-get={ data.NextURL } hx-target="#knowledge-graph-panel" hx-swap="innerHTML">下一页</button>
				}
			</div>
		}
	</div>
}
