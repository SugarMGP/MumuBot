package views

import (
	"fmt"
	"mumu-bot/internal/web/services"
)

templ TopicListPage(data TopicListPageData, currentPath string) {
	@Layout(LayoutData{Title: "话题管理", CurrentPath: currentPath, NavItems: NavItems(), Flash: data.Flash}, TopicListBody(data))
}

templ TopicListBody(data TopicListPageData) {
	<div class="admin-memory-page space-y-6">
		@PageHeader("话题管理", "查看当前摘要、未完事项与原文依据。", "")
		@FilterPanel("topic-filters", "筛选条件", EmptyComponent(), false, TopicFilterForm(data))
		if len(data.Items) == 0 {
			<div class="card border-dashed"><div class="card-body items-center py-14 text-sm text-base-content/60">当前筛选条件下暂无话题</div></div>
		}
		if len(data.Items) > 0 {
			<div class="grid grid-cols-[repeat(auto-fill,minmax(380px,1fr))] gap-4">
				for _, item := range data.Items {
					{{ keywords := topicKeywords(item) }}
					<a href={ templ.SafeURL(WithQuery(fmt.Sprintf("/admin/topics/%d", item.ID), "return_to", data.CurrentURL)) } class="admin-record-card card bg-base-100 transition-colors" data-tone={ topicTone(item) }>
						<div class="card-body gap-4 p-5 pl-6">
							<div class="flex items-start justify-between gap-4">
								<div class="min-w-0">
									<h2 class="line-clamp-2 text-lg font-semibold leading-6 text-base-content">{ topicTitle(item) }</h2>
									<p class="admin-number mt-1 text-xs text-base-content/60">{ conversationText(item.ConversationKind, item.TargetID) } · 话题 #{ fmt.Sprintf("%d", item.ID) }</p>
								</div>
								<span class={ joinClasses("shrink-0", topicStateClass(item)) }>{ topicStateText(item) }</span>
							</div>
							<p class="line-clamp-3 text-sm leading-7 text-base-content/75" title={ topicGist(item) }>{ topicGist(item) }</p>
							<div class="flex flex-wrap gap-2">
								for _, keyword := range keywords[:min(3,len(keywords))] {
									<span class="badge badge-primary badge-soft badge-sm">{ keyword }</span>
								}
							</div>
							<div class="flex items-center justify-between border-t border-base-300 pt-3 text-xs text-base-content/60">
								<span>{ topicUpdatedTime(item) } · { fmt.Sprint(item.MessageCount) } 条消息 · 关键 { fmt.Sprint(len(item.AnchorMessageIDs)) } 条 · 待续 { fmt.Sprint(len(topicSummary(item).OpenLoops)) } 项</span>
								<span class="flex items-center gap-1 font-medium text-primary">
									<span>查看详情</span>@AdminIcon("arrow-right", "size-3.5", "topic-detail-arrow")
								</span>
							</div>
						</div>
					</a>
				}
			</div>
		}
		@ListFooter(data.Meta)
	</div>
}

templ TopicFilterForm(data TopicListPageData) {
	<form id="topic-filter-form" class="grid grid-cols-[clamp(170px,24vw,240px)_clamp(120px,14vw,160px)_minmax(0,1fr)_auto] items-center gap-3" method="get" action="/admin/topics" hx-get="/admin/topics" hx-trigger="submit" hx-target="#admin-page-body" hx-swap="outerHTML" hx-push-url="true">
		<select class="select w-full" name="conversation" aria-label="会话">
			<option value="">全部会话</option>
			for _,item:=range data.Conversations {
				<option value={ item.Kind+":"+fmt.Sprint(item.TargetID) } selected?={ item.Kind+":"+fmt.Sprint(item.TargetID)==data.Conversation }>{ conversationLabel(item) }</option>
			}
		</select>
		<select class="select w-full" name="status" aria-label="状态">
			<option value="">全部状态</option>
			<option value="active" selected?={ data.Status=="active" }>当前话题</option>
			<option value="dormant" selected?={ data.Status=="dormant" }>可检索话题</option>
		</select>
		<input class="input w-full border-base-300 focus:border-primary" type="search" name="keyword" value={ data.Keyword } placeholder="输入话题关键词…" aria-label="话题关键词"/>
		<button class="btn btn-primary min-w-24" type="submit" data-loading-label="筛选中">
			@AdminIcon("filter", "size-4", "topic-filter")
			<span>筛选</span>
		</button>
	</form>
}

templ TopicDetailPage(data TopicDetailPageData, currentPath string) {
	@Layout(LayoutData{Title: topicTitle(data.Thread), CurrentPath: currentPath, NavItems: NavItems(), Flash: data.Flash}, TopicDetailBody(data))
}

templ TopicDetailBody(data TopicDetailPageData) {
	<div class="admin-memory-page space-y-6">
		<header class="flex flex-col gap-3">
			<div class="flex min-w-0 items-center gap-3">
				<a class="btn btn-ghost btn-circle btn-sm" href={ templ.SafeURL(displayText(data.ReturnTo, "/admin/topics")) } aria-label="返回话题列表">
					@AdminIcon("chevron-left", "size-4", "topic-back")
				</a>
				<h1 class="admin-page-title min-w-0 truncate font-semibold">{ topicTitle(data.Thread) }</h1>
			</div>
			<div class="flex flex-wrap items-center gap-x-3 gap-y-1 pl-1 text-xs text-base-content/60">
				<span class="badge badge-ghost badge-sm">{ conversationText(data.Thread.ConversationKind, data.Thread.TargetID) }</span>
				<span class={ topicStateClass(data.Thread) }>{ topicStateText(data.Thread) }</span>
				<span class="badge badge-ghost badge-sm">关键消息 { fmt.Sprint(len(data.Thread.AnchorMessageIDs)) } 条</span>
				<span class="badge badge-ghost badge-sm">原文 { fmt.Sprint(len(data.Thread.SourceMessageIDs)) } 条</span>
				<span>更新于 { topicUpdatedTime(data.Thread) }</span>
			</div>
		</header>
		<div class="grid grid-cols-[minmax(0,1fr)_clamp(280px,24vw,340px)] items-start gap-4">
			<div class="space-y-4">
				@TopicCurrentSummary(data.Thread)
				<section class="card">
					<div class="card-body p-5">
						<div>
							<h2 class="text-lg font-semibold text-base-content">最近关联消息</h2>
							<p class="mt-1 text-xs text-base-content/60">按时间顺序排列</p>
							if len(data.Messages)>=80 {
								<p class="mt-1 text-xs text-warning">当前展示最近 80 条，可能还有更早记录</p>
							}
						</div>
						if len(data.Messages) == 0 {
							<div class="py-10 text-center text-sm text-base-content/60">暂无关联消息</div>
						}
						if len(data.Messages) > 0 {
							<div class="mt-2 space-y-3">
								for _, item := range data.Messages {
									<article class={ joinClasses("rounded-xl border p-3", ternaryString(item.RecalledAt != nil, "border-error/25 bg-error/5", "border-base-300 bg-base-200/45")) }>
										<div class="flex items-center justify-between gap-3">
											<div class="flex min-w-0 items-center gap-2">
												<span class="min-w-0 truncate text-xs font-medium text-base-content/75">{ topicMessageSender(item) }</span>
												if topicMessageAnchor(data.Thread, item.ID) {
													<span class="badge badge-warning badge-soft badge-xs shrink-0">关键消息</span>
												}
												if topicMessageSource(data.Thread, item.ID) {
													<span class="badge badge-primary badge-soft badge-xs shrink-0">摘要来源</span>
												}
												if item.RecalledAt != nil {
													<span class="badge badge-error badge-soft badge-xs shrink-0">已撤回</span>
												}
											</div>
											<time class="shrink-0 text-xs text-base-content/60" datetime={ formatTimeAttr(item.MessageTime) }>{ formatTime(item.MessageTime) }</time>
										</div>
										<p class={ joinClasses("mt-1 whitespace-pre-wrap break-words text-sm leading-6", ternaryString(item.RecalledAt != nil, "text-error", "text-base-content/75")) }>{ topicMessageText(item) }</p>
									</article>
								}
							</div>
						}
					</div>
				</section>
			</div>
			<aside class="card">
				<div class="card-body gap-3 p-4">
					<div><h2 class="text-lg font-semibold text-base-content">摘要生成历史</h2><p class="mt-1 text-xs text-base-content/60">{ topicSummaryChangeCountLabel(data.Thread, data.SummaryChanges) }</p></div>
					if len(data.SummaryChanges) == 0 {
						<div class="py-8 text-center text-sm text-base-content/60">还没有摘要快照</div>
					}
					<div class="admin-topic-summary-timeline">
						for _, change := range data.SummaryChanges {
							@TopicSummaryChangeCard(change)
						}
					</div>
				</div>
			</aside>
		</div>
	</div>
}

templ TopicCurrentSummary(topic services.TopicThreadView) {
	<section class="card">
		<div class="card-body gap-4 p-5">
			<div class="flex items-center gap-2 text-primary">
				@AdminIcon("memories", "size-5", "topic-summary")
				<h2 class="text-lg font-semibold text-base-content">当前摘要</h2>
				if latest := topic.LatestSummary(); latest != nil {
					<span class="badge badge-ghost badge-sm">v{ fmt.Sprint(latest.Version) }</span>
				}
			</div>
			<p class="text-sm leading-7 text-base-content/75">{ topicGist(topic) }</p>
			<div class="divider my-0"></div>
			<div>
				<h3 class="text-xs font-semibold text-base-content/60">相关关键词</h3>
				<div class="mt-3 flex flex-wrap gap-2">
					<span class="text-xs text-base-content/60">{ topicUpdatedTime(topic) }</span>
					for _, keyword := range topicKeywords(topic) {
						<span class="badge badge-primary badge-soft badge-sm">{ keyword }</span>
					}
				</div>
			</div>
			if len(topicSummary(topic).Participants) > 0 {
				<div>
					<h3 class="text-xs font-semibold text-base-content/60">参与人</h3>
					<div class="mt-2 flex flex-wrap gap-2">
						for _, participant := range topicSummary(topic).Participants {
							<div class="flex items-center gap-2 rounded-lg border border-base-300 px-2.5 py-1.5 text-xs">
								<span class="font-medium text-base-content/75">{ displayText(participant.Nickname, fmt.Sprintf("%d", participant.UserID)) }</span>
							</div>
						}
					</div>
				</div>
			}
			if len(topicSummary(topic).OpenLoops) > 0 {
				<div>
					<h3 class="text-xs font-semibold text-base-content/60">未完事项</h3>
					<ul class="mt-2 space-y-2">
						for _, item := range topicSummary(topic).OpenLoops {
							<li class="flex items-start gap-2 text-sm"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-warning"></span><span class="text-base-content/75">{ item }</span></li>
						}
					</ul>
				</div>
			}
		</div>
	</section>
}

templ TopicSummaryChangeCard(change TopicSummaryChangeView) {
	<details class="admin-topic-change-card">
		<summary class="admin-topic-change-card__summary">
			<span class="admin-topic-change-card__rail" aria-hidden="true"></span>
			<div class="min-w-0 flex-1">
				<time class="text-xs text-base-content/60" datetime={ change.CapturedAtValue }>{ change.CapturedAtLabel }</time>
				<p class="mt-1 text-sm font-medium leading-5">{ change.Headline }</p>
				<div class="mt-2 flex flex-wrap gap-1">
					for _, badge := range change.Badges {
						<span class={ topicChangeBadgeClass(badge.Tone) }>{ badge.Label }</span>
					}
				</div>
			</div>
			@AdminIcon("chevron-down", "size-4 admin-topic-change-card__chevron", "topic-change-chevron")
		</summary>
		<div class="admin-topic-change-card__body">
			if change.TitleChanged {
				@TopicInlineDiff("标题变化", change.TitleDiff)
			}
			if change.GistChanged {
				@TopicInlineDiff("概括变化", change.GistDiff)
			}
			if len(change.AddedOpenLoops) > 0 {
				<div>
					<h4 class="text-xs font-medium text-warning">新增待办</h4>
					<ul class="mt-1 space-y-1">
						for _, item := range change.AddedOpenLoops {
							<li class="text-xs leading-5 text-base-content/75">+ { item }</li>
						}
					</ul>
				</div>
			}
			if len(change.RemovedOpenLoops) > 0 {
				<div>
					<h4 class="text-xs font-medium text-error">移除待办</h4>
					<ul class="mt-1 space-y-1">
						for _, item := range change.RemovedOpenLoops {
							<li class="text-xs leading-5 text-base-content/75">- { item }</li>
						}
					</ul>
				</div>
			}
		</div>
	</details>
}

templ TopicInlineDiff(label string, diff TopicTextDiffView) {
	<div>
		<h4 class="mb-2 text-xs font-medium text-base-content/60">{ label }</h4>
		<div class="admin-topic-inline-diff">
			if len(diff.InlineSegments) == 0 {
				<span class="admin-topic-inline-diff__placeholder">{ diff.CurrentPlaceholder }</span>
			}
			for _, segment := range diff.InlineSegments {
				<span class={ topicInlineDiffClass(segment.Kind) }>{ segment.Text }</span>
			}
		</div>
	</div>
}
