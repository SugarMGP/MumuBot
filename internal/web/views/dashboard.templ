package views

import "fmt"

templ DashboardPage(data DashboardPageData, currentPath string) {
	@Layout(LayoutData{Title: "首页", CurrentPath: currentPath, NavItems: NavItems(), Flash: data.Flash}, DashboardBody(data))
}

templ DashboardMetric(icon string, label string, value string, tone string) {
	<div class={ joinClasses("card border border-base-300 bg-base-100", tone) }>
		<div class="card-body flex-row items-center gap-3 p-4">
			<span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-base-200 text-base-content/65">@AdminIcon(icon, "size-5", "dashboard-"+icon)</span>
			<div><div class="text-xs text-base-content/50">{ label }</div><div class="admin-number mt-1 text-xl font-semibold text-base-content">{ value }</div></div>
		</div>
	</div>
}

templ DashboardBody(data DashboardPageData) {
	<div class="space-y-6">
		@PageHeader("首页", "查看机器人运行状态与学习概况。", "")
		<section class="grid grid-cols-6 gap-3">
			@DashboardMetric("groups", "启用群聊", fmt.Sprintf("%d", data.EnabledGroupCount), "bg-[#eef5ff]")
			@DashboardMetric("memories", "长期记忆", fmt.Sprintf("%d", data.MemoryCount), "bg-[#fff1f3]")
			@DashboardMetric("members", "成员画像", fmt.Sprintf("%d", data.MemberCount), "bg-[#fff5ee]")
			@DashboardMetric("jargons", "黑话词典", fmt.Sprintf("%d", data.JargonCount), "bg-[#eff9f4]")
			@DashboardMetric("style-cards", "风格卡片", fmt.Sprintf("%d", data.StyleCardCount), "bg-[#f5f0ff]")
			@DashboardMetric("stickers", "表情包", fmt.Sprintf("%d", data.StickerCount), "bg-[#fff8e8]")
		</section>
		<div class="grid grid-cols-[minmax(0,2fr)_minmax(280px,0.8fr)] gap-4">
			<section class="card border border-base-300 bg-base-100">
				<div class="card-body p-5">
					<div class="flex items-center justify-between"><div><h2 class="font-semibold">当前心情</h2><p class="mt-1 text-xs text-base-content/50">机器人此刻的情绪与交流意愿</p></div><span class="badge badge-primary badge-soft">实时</span></div>
					if data.CurrentMood != nil {
						<div class="admin-mood-chart" data-admin-mood-chart data-valence={ fmt.Sprintf("%.4f", data.CurrentMood.Valence) } data-energy={ fmt.Sprintf("%.4f", data.CurrentMood.Energy) } data-sociability={ fmt.Sprintf("%.4f", data.CurrentMood.Sociability) }></div>
					} else {
						<div class="flex h-[220px] items-center justify-center text-sm text-base-content/45">暂无心情数据</div>
					}
				</div>
			</section>
			<section class="card border border-base-300 bg-base-100">
				<div class="card-body p-5">
					<div class="flex items-center justify-between"><h2 class="font-semibold">运行状态</h2>@AdminIcon("connection", "size-5 text-success", "runtime")</div>
					<div class="mt-2 divide-y divide-base-300 text-sm">
						<div class="flex items-center justify-between py-3"><span class="text-base-content/58">OneBot 连接</span><span class={ ternaryString(data.OneBotConnected, "badge badge-success badge-soft badge-sm", "badge badge-error badge-soft badge-sm") }>{ ConnectionText(data.OneBotConnected) }</span></div>
						<div class="flex items-center justify-between py-3"><span class="text-base-content/58">机器人账号</span><code class="text-xs">{ fmt.Sprintf("%d", data.SelfID) }</code></div>
						<div class="flex items-center justify-between py-3"><span class="text-base-content/58">扩展工具</span><span>{ fmt.Sprintf("%d", data.MCPToolCount) }</span></div>
						<div class="flex items-center justify-between py-3"><span class="text-base-content/58">学习状态</span><span class="badge badge-success badge-soft badge-sm">{ boolText(data.LearningEnabled) }</span></div>
					</div>
				</div>
			</section>
		</div>
		if data.CurrentMood != nil {
			<section class="card border border-base-300 bg-base-100"><div class="card-body flex-row items-center gap-4 p-4"><span class="inline-flex size-10 items-center justify-center rounded-full bg-primary/10 text-primary">@AdminIcon("mood", "size-5", "mood-reason")</span><div><h2 class="text-sm font-semibold">当前状态摘要</h2><p class="mt-1 text-sm text-base-content/58">{ EmptyDash(data.CurrentMood.LastReason) }</p></div></div></section>
		}
	</div>
}
