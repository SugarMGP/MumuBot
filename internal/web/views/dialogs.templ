package views

templ DialogCloseButton(selector string) {
	<button type="button" class="btn btn-ghost btn-circle btn-sm" data-admin-dialog-close={ selector } aria-label="关闭弹层">
		@AdminIcon("x", "size-4", "dialog-x")
	</button>
}

templ AdminActionDialogContent(data AdminActionDialogContentData) {
	<div class="space-y-5">
		<div class="flex items-start justify-between gap-4">
			<div class="min-w-0">
				<h3 id="admin-action-dialog-title" class="text-xl font-semibold text-base-content">{ data.Title }</h3>
				if data.Body != "" {
					<p class="mt-2 text-sm leading-6 text-base-content/60">{ data.Body }</p>
				}
			</div>
			@DialogCloseButton("#admin-action-dialog")
		</div>
		if data.Spotlight != "" {
			<div class="admin-quote text-base font-medium leading-7">{ data.Spotlight }</div>
		}
		if len(data.Chips) > 0 {
			<div class="flex flex-wrap gap-2">
				for _, chip := range data.Chips {
					<span class={ dialogChipClass(chip.Kind) }>{ chip.Label }</span>
				}
			</div>
		}
		if len(data.Fields) > 0 {
			<div class={ ternaryString(len(data.Fields) > 1, "grid grid-cols-2 gap-3", "grid gap-3") }>
				for _, field := range data.Fields {
					<div class="rounded-box bg-base-200 p-4">
						<strong class="text-xs font-medium text-base-content/50">{ field.Label }</strong>
						<div class="mt-2 max-h-56 overflow-y-auto whitespace-pre-line break-words text-sm leading-6 text-base-content/75">{ field.Value }</div>
					</div>
				}
			</div>
		}
		<form method="post" action="/admin/actions" hx-post="/admin/actions" hx-target="#admin-page-body" hx-swap="outerHTML" data-admin-action-dialog-form>
			<input type="hidden" name="return_to" value={ data.ReturnTo }/>
			for _, field := range data.Hidden {
				<input type="hidden" name={ field.Name } value={ field.Value }/>
			}
			<div class="modal-action">
				<button type="button" class="btn btn-ghost" data-admin-dialog-close="#admin-action-dialog">取消</button>
				<button class={ data.SubmitClass } type="submit" data-loading-label={ data.BusyLabel }>{ data.SubmitLabel }</button>
			</div>
		</form>
	</div>
}

templ StickerPreviewDialog(data StickerPreviewDialogData) {
	<div class="space-y-5">
		<div class="flex items-start justify-between gap-4">
			<div>
				<h3 id="admin-sticker-preview-dialog-title" class="text-xl font-semibold">表情包预览</h3>
				<p class="mt-2 text-sm text-base-content/60">查看图片和文件信息。</p>
			</div>
			@DialogCloseButton("#admin-sticker-preview-dialog")
		</div>
		<div class="flex min-h-80 items-center justify-center rounded-box bg-base-200 p-5">
			<img class="block max-h-[32rem] max-w-full object-contain" src={ data.FileURL } alt={ data.Description } loading="lazy"/>
		</div>
		<div class="grid grid-cols-2 gap-3">
			<div class="rounded-box bg-base-200 p-4"><strong class="text-xs text-base-content/50">描述</strong><div class="mt-2 text-sm">{ data.Description }</div></div>
			<div class="rounded-box bg-base-200 p-4"><strong class="text-xs text-base-content/50">文件名</strong><div class="mt-2 break-all text-sm">{ data.FileName }</div></div>
			<div class="rounded-box bg-base-200 p-4"><strong class="text-xs text-base-content/50">哈希</strong><div class="mt-2 break-all text-sm">{ data.FileHash }</div></div>
			<div class="rounded-box bg-base-200 p-4"><strong class="text-xs text-base-content/50">统计</strong><div class="mt-2 text-sm">{ data.Meta }</div></div>
		</div>
		<div class="modal-action">
			<a class="btn btn-success btn-soft" href={ data.FileURL } target="_blank" rel="noreferrer">新窗口打开</a>
			<button type="button" class="btn btn-ghost" data-admin-dialog-close="#admin-sticker-preview-dialog">关闭</button>
		</div>
	</div>
}

templ DialogErrorContent(overlayID string, title string, body string) {
	<div class="space-y-5">
		<div class="flex items-start justify-between gap-4">
			<div><h3 class="text-xl font-semibold">{ title }</h3><p class="mt-2 text-sm leading-6 text-base-content/60">{ body }</p></div>
			@DialogCloseButton("#" + overlayID)
		</div>
		<div class="alert alert-error alert-soft text-sm">{ body }</div>
	</div>
}
