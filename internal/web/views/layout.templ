package views

import "fmt"

templ AdminHead(title string, flash *FlashMessage) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta name="color-scheme" content="light"/>
		<title>{ title } - MumuBot</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.ico"/>
		if flash != nil {
			<meta id="admin-flash-payload" name="admin-flash" content={ flashJSON(flash) }/>
		}
		<link rel="stylesheet" href="/assets/admin.css"/>
		<script type="text/javascript" src="/assets/admin.js" defer></script>
	</head>
}

templ Layout(data LayoutData, content templ.Component) {
	@LayoutWithOverlay(data, content, EmptyComponent())
}

templ EmptyComponent() {
}

templ PageContent(content templ.Component) {
	<div id="admin-page-body" class="admin-page-enter">
		@content
	</div>
}

templ LayoutWithOverlay(data LayoutData, content templ.Component, overlay templ.Component) {
	<!doctype html>
	<html lang="zh-CN" data-theme="mumubot">
		@AdminHead(data.Title, data.Flash)
		<body class="font-sans antialiased selection:bg-primary/20">
			<div class="admin-shell">
				<aside class="admin-sidebar">
					@SidebarPanel(data)
				</aside>
				<div class="min-w-0">
					<header class="admin-topbar">
						<div class="flex items-center gap-3">
							<span class="text-base font-semibold text-base-content">MumuBot 管理后台</span>
							<span class="h-4 w-px bg-base-300"></span>
							<span class="text-sm text-base-content/55">{ data.Title }</span>
						</div>
						<div class="flex items-center gap-3">
							<span class="badge badge-success badge-soft badge-sm">服务在线</span>
							<div class="avatar placeholder" aria-hidden="true">
								<div class="w-9 rounded-full border border-primary/15 bg-primary/10 text-primary"><span class="text-xs font-semibold">M</span></div>
							</div>
						</div>
					</header>
					<main class="admin-page">
						@PageContent(content)
					</main>
				</div>
				@AdminActionDialog()
				@overlay
			</div>
		</body>
	</html>
}

templ AdminActionDialog() {
	<dialog id="admin-action-dialog" class="modal" aria-labelledby="admin-action-dialog-title">
		<div class="modal-box max-h-[86vh] max-w-xl border border-base-300 p-6">
			<div id="admin-action-dialog-content">
				@DialogLoadingPlaceholder("确认操作", "正在载入操作内容。")
			</div>
		</div>
		<form method="dialog" class="modal-backdrop"><button aria-label="关闭确认弹层">关闭</button></form>
	</dialog>
}

templ SidebarPanel(data LayoutData) {
	<div class="flex h-full flex-col px-3 py-5">
		<div class="flex items-center gap-3 px-3 pb-5">
			<div class="avatar placeholder">
				<div class="w-10 rounded-full bg-primary text-primary-content"><span class="text-sm font-semibold">M</span></div>
			</div>
			<div>
				<div id="admin-sidebar-title" class="text-lg font-semibold leading-5 text-base-content">MumuBot</div>
				<div class="mt-1 text-xs text-base-content/55">管理后台</div>
			</div>
		</div>
		<nav class="min-h-0 flex-1 overflow-y-auto" aria-label="后台导航">
			<ul class="menu w-full gap-1 p-0">
				for _, item := range data.NavItems {
					<li>
						<a href={ item.Href } title={ item.Label } class={ navClass(data.CurrentPath, item.Href) }>
							@AdminIcon(navIconName(item.Href), "size-[18px]", "nav-"+navIconName(item.Href))
							<span>{ item.Label }</span>
						</a>
					</li>
				}
			</ul>
		</nav>
		<form class="mt-4 border-t border-base-300 pt-4" method="post" action="/logout">
			<button class="btn btn-ghost w-full justify-start text-base-content/65" type="submit" data-loading-label="退出中">
				<svg class="size-[18px]" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M7 4.75H5.75A1.75 1.75 0 0 0 4 6.5v7a1.75 1.75 0 0 0 1.75 1.75H7"></path>
					<path d="M11 6.5 14.5 10 11 13.5M8 10h6.5"></path>
				</svg>
				<span>退出登录</span>
			</button>
		</form>
	</div>
}

templ PageHeader(title string, subtitle string, tag string) {
	<div>
		<div class="flex items-center gap-3">
			<h1 class="text-[2.15rem] font-semibold leading-tight text-base-content">{ title }</h1>
			if tag != "" {
				<span class="badge badge-primary badge-soft">{ tag }</span>
			}
		</div>
		if subtitle != "" {
			<p class="mt-1.5 max-w-3xl text-sm leading-6 text-base-content/58">{ subtitle }</p>
		}
	</div>
}

templ SortToolbar(data SortToolbarData) {
	if len(data.Options) > 0 || len(data.OrderOptions) > 0 {
		<div class="flex items-center justify-between gap-4 border-t border-base-300 pt-4">
			<div class="text-sm text-base-content/55">{ data.Summary }</div>
			<div class="flex items-center gap-2">
				if len(data.Options) > 0 {
					<div class="join">
						for _, option := range data.Options {
							<a class={ joinClasses(sortToolbarLinkClass(option.Active), "join-item") } href={ option.Href } hx-get={ option.Href } hx-target="#admin-page-body" hx-swap="outerHTML" hx-push-url="true">{ option.Label }</a>
						}
					</div>
				}
				if len(data.OrderOptions) > 0 {
					<div class="join">
						for _, option := range data.OrderOptions {
							<a class={ joinClasses(sortToolbarLinkClass(option.Active), "join-item btn-square") } href={ option.Href } hx-get={ option.Href } hx-target="#admin-page-body" hx-swap="outerHTML" hx-push-url="true" aria-label={ sortOrderAriaLabel(option.Label) } title={ sortOrderAriaLabel(option.Label) }>
								@AdminIcon(sortOrderIconName(option.Label), "size-4", sortOrderIconName(option.Label))
							</a>
						}
					</div>
				}
			</div>
		</div>
	}
}

templ ListFooter(meta ListMeta) {
	<div class="mt-6 flex items-center justify-between border-t border-base-300 pt-4 text-sm text-base-content/55">
		<div>{ metaSummary(meta) }</div>
		<div class="join">
			if meta.PrevURL != "" {
				<a class="btn btn-ghost btn-sm btn-square join-item border-base-300" href={ meta.PrevURL } hx-get={ meta.PrevURL } hx-target="#admin-page-body" hx-swap="outerHTML" hx-push-url="true" aria-label="上一页"><svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m12.5 5-5 5 5 5"></path></svg></a>
			}
			<button class="btn btn-primary btn-sm join-item" type="button" aria-current="page">{ fmt.Sprintf("%d", meta.Page) }</button>
			if meta.NextURL != "" {
				<a class="btn btn-ghost btn-sm btn-square join-item border-base-300" href={ meta.NextURL } hx-get={ meta.NextURL } hx-target="#admin-page-body" hx-swap="outerHTML" hx-push-url="true" aria-label="下一页"><svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m7.5 5 5 5-5 5"></path></svg></a>
			}
		</div>
	</div>
}

templ ChoiceFilterGroup(name string, current string, options []FilterChoice) {
	@ChoiceFilterGroupForFormAligned("", name, current, options, "")
}

templ ChoiceFilterGroupForForm(formID string, name string, current string, options []FilterChoice) {
	@ChoiceFilterGroupForFormAligned(formID, name, current, options, "")
}

templ ChoiceFilterGroupForFormAligned(formID string, name string, current string, options []FilterChoice, alignClass string) {
	<div data-admin-choice-group={ name } class={ joinClasses("join", alignClass) }>
		for _, option := range options {
			<label class={ joinClasses(filterChoiceClass(equalTrimmed(option.Value, current)), "join-item") }>
				if formID != "" {
					<input class="sr-only" type="radio" name={ name } value={ option.Value } form={ formID } checked?={ equalTrimmed(option.Value, current) }/>
				} else {
					<input class="sr-only" type="radio" name={ name } value={ option.Value } checked?={ equalTrimmed(option.Value, current) }/>
				}
				<span>{ option.Label }</span>
			</label>
		}
	</div>
}

templ FilterPanel(id string, title string, summary string, controls templ.Component, hasControls bool, content templ.Component) {
	<section id={ id } class="card border border-base-300 bg-base-100">
		<div class="card-body gap-4 p-4">
			<div class="flex items-center justify-between gap-6">
				<div class="min-w-0">
					<h2 class="text-sm font-semibold text-base-content">{ title }</h2>
					if summary != "" {
						<p class="mt-1 text-xs text-base-content/50">{ summary }</p>
					}
				</div>
				if hasControls {
					<div class="shrink-0">@controls</div>
				}
			</div>
			@content
		</div>
	</section>
}

templ DialogLoadingPlaceholder(title string, summary string) {
	<div class="space-y-5">
		<div class="flex items-start justify-between gap-4">
			<div><h3 id="admin-action-dialog-title" class="text-xl font-semibold">{ title }</h3><p class="mt-2 text-sm text-base-content/60">{ summary }</p></div>
			<button type="button" class="btn btn-ghost btn-circle btn-sm" data-admin-dialog-close="#admin-action-dialog" aria-label="关闭弹层">
				<svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 6 8 8M14 6l-8 8"></path></svg>
			</button>
		</div>
		<div class="space-y-3"><div class="skeleton h-24 w-full"></div><div class="grid grid-cols-2 gap-3"><div class="skeleton h-20"></div><div class="skeleton h-20"></div></div></div>
	</div>
}
