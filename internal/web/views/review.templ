package views

import "fmt"

templ StyleCardListPage(data StyleCardListPageData, currentPath string) {
	@Layout(LayoutData{Title: "风格卡片", CurrentPath: currentPath, NavItems: NavItems(), Flash: data.Flash}, StyleCardListBody(data))
}

templ StyleCardListBody(data StyleCardListPageData) {
	<div class="space-y-6">
		@PageHeader("风格卡片", "审核群聊中学习到的表达风格。", "")
		@FilterPanel("style-card-filters", "筛选条件", "按群号、关键词和状态查找风格卡片。", StyleCardFilterControls(data), true, StyleCardFilterForm(data))
		@SortToolbar(data.Sort)
		if len(data.Items) == 0 {
			<div class="card border border-dashed border-base-300 bg-base-100"><div class="card-body items-center py-14 text-sm text-base-content/45">当前筛选条件下暂无风格卡片</div></div>
		}
		if len(data.Items) > 0 {
			<div class="grid grid-cols-2 gap-4">
				for _, item := range data.Items {
					<article class="admin-record-card card border border-base-300 bg-base-100" data-tone={ styleCardTone(item.Status) }>
						<div class="card-body gap-4 p-5 pl-6">
							<div class="flex items-start justify-between gap-4">
								<div>
									<div class="flex items-center gap-2">
										<h2 class="text-xl font-semibold">{ item.Situation }</h2>
										<span class={ styleCardStatusClass(item.Status) }>{ styleCardStatusText(item.Status) }</span>
									</div>
									<p class="mt-1 text-xs text-base-content/50">群号：{ fmt.Sprintf("%d", item.GroupID) } <time datetime={ formatTimeAttr(item.UpdatedAt) }>{ formatTime(item.UpdatedAt) }</time></p>
								</div>
								<div class="flex shrink-0 gap-2">
									for _, action := range styleCardActions(item.Status) {
										<button class={ rowActionClass(action) } type="button" data-admin-dialog="#admin-action-dialog" hx-get={ styleCardActionDialogHref(item.ID, action.Value) } hx-target="#admin-action-dialog-content" hx-swap="innerHTML">{ action.Label }</button>
									}
								</div>
							</div>
							<blockquote class="admin-quote rounded-xl p-4 text-base italic leading-7 text-base-content">“{ item.Expression }”</blockquote>
							<div><h3 class="text-xs font-semibold text-base-content/60">消息证据</h3><div class="mt-2 space-y-2 border-l-2 border-base-300 pl-4">
								if len(item.Evidence) == 0 {
									<p class="text-sm text-base-content/45">暂无关联消息</p>
								}
								for i, evidence := range item.Evidence {
									if i < 3 {
										<p class="text-sm leading-6 text-base-content/72"><span class="font-medium text-info">{ "@" + evidence.Nickname }</span>：{ evidence.TextContent }</p>
									}
								}
							</div></div>
						</div>
					</article>
				}
			</div>
		}
		@ListFooter(data.Meta)
	</div>
}

templ StyleCardFilterControls(data StyleCardListPageData) {
	@ChoiceFilterGroupForForm("style-card-filter-form", "status", data.Status, []FilterChoice{{Label: "全部", Value: ""}, {Label: "待审核", Value: "candidate"}, {Label: "已启用", Value: "active"}, {Label: "已拒绝", Value: "rejected"}})
}

templ StyleCardFilterForm(data StyleCardListPageData) {
	<form id="style-card-filter-form" class="grid grid-cols-[180px_minmax(220px,1fr)_auto] items-center gap-3" method="get" action="/admin/style-cards" hx-get="/admin/style-cards" hx-trigger="change from:input[form='style-card-filter-form'], submit" hx-target="#admin-page-body" hx-swap="outerHTML" hx-push-url="true">
		<input type="hidden" name="sort" value={ data.Sort.CurrentSort }/><input type="hidden" name="order" value={ data.Sort.CurrentOrder }/>
		<input class="input w-full border-base-300 focus:border-primary" type="text" name="group_id" value={ data.GroupID } placeholder="群号 / 群名"/>
		<input class="input w-full border-base-300 focus:border-primary" type="search" name="keyword" value={ data.Keyword } placeholder="关键词"/>
		<button class="btn btn-primary min-w-24" type="submit" data-loading-label="筛选中">@AdminIcon("filter", "size-4", "style-filter")<span>筛选</span></button>
	</form>
}

templ JargonListPage(data JargonListPageData, currentPath string) {
	@Layout(LayoutData{Title: "黑话词典", CurrentPath: currentPath, NavItems: NavItems(), Flash: data.Flash}, JargonListBody(data))
}

templ JargonListBody(data JargonListPageData) {
	<div class="space-y-6">
		@PageHeader("黑话词典", "审核群聊中学习到的词语和含义。", "")
		@FilterPanel("jargon-filters", "筛选条件", "按群号、关键词和状态查找词条。", JargonFilterControls(data), true, JargonFilterForm(data))
		@SortToolbar(data.Sort)
		if len(data.Items) == 0 {
			<div class="card border border-dashed border-base-300 bg-base-100"><div class="card-body items-center py-14 text-sm text-base-content/45">当前筛选条件下暂无黑话记录</div></div>
		}
		if len(data.Items) > 0 {
			<div class="grid grid-cols-2 gap-4">
				for _, item := range data.Items {
					<article class="admin-record-card card border border-base-300 bg-base-100" data-tone={ jargonTone(item.Jargon) }>
						<div class="card-body gap-4 p-5 pl-6">
							<div class="flex items-start justify-between gap-4">
								<div>
									<div class="flex items-center gap-2">
										<h2 class="text-xl font-semibold">{ item.Term }</h2>
										<span class={ jargonStatusClass(item.Jargon) }>{ jargonStatusText(item.Jargon) }</span>
									</div>
									<p class="mt-1 text-xs text-base-content/50">群 { fmt.Sprintf("%d", item.GroupID) } <time datetime={ formatTimeAttr(item.UpdatedAt) }>{ formatTime(item.UpdatedAt) }</time></p>
								</div>
								<div class="flex shrink-0 gap-2">
									for _, action := range jargonActions(jargonStatusValue(item.Jargon)) {
										<button class={ rowActionClass(action) } type="button" data-admin-dialog="#admin-action-dialog" hx-get={ jargonActionDialogHref(item.ID, action.Value) } hx-target="#admin-action-dialog-content" hx-swap="innerHTML">{ action.Label }</button>
									}
								</div>
							</div>
							<div class="admin-quote rounded-xl p-4"><span class="font-medium">释义：</span><span class="text-sm leading-7 text-base-content/72">{ item.Meaning }</span></div>
							<div><h3 class="text-xs font-semibold text-base-content/60">学习来源（上下文）</h3><div class="mt-2 space-y-2 border-l-2 border-base-300 pl-4">
								if len(item.Evidence) == 0 {
									<p class="text-sm text-base-content/45">暂无关联消息</p>
								}
								for i, evidence := range item.Evidence {
									if i < 3 {
										<p class="text-sm leading-6 text-base-content/72"><span class="font-medium">{ evidence.Nickname }</span>：{ evidence.TextContent }</p>
									}
								}
							</div></div>
						</div>
					</article>
				}
			</div>
		}
		@ListFooter(data.Meta)
	</div>
}

templ JargonFilterControls(data JargonListPageData) {
	@ChoiceFilterGroupForForm("jargon-filter-form", "status", data.Status, []FilterChoice{{Label: "全部", Value: ""}, {Label: "待审核", Value: "candidate"}, {Label: "已启用", Value: "active"}, {Label: "已拒绝", Value: "rejected"}})
}

templ JargonFilterForm(data JargonListPageData) {
	<form id="jargon-filter-form" class="grid grid-cols-[180px_minmax(220px,1fr)_auto] items-center gap-3" method="get" action="/admin/jargons" hx-get="/admin/jargons" hx-trigger="change from:input[form='jargon-filter-form'], submit" hx-target="#admin-page-body" hx-swap="outerHTML" hx-push-url="true">
		<input type="hidden" name="sort" value={ data.Sort.CurrentSort }/><input type="hidden" name="order" value={ data.Sort.CurrentOrder }/>
		<input class="input w-full border-base-300 focus:border-primary" type="text" name="group_id" value={ data.GroupID } placeholder="群号 / 群名"/>
		<input class="input w-full border-base-300 focus:border-primary" type="search" name="keyword" value={ data.Keyword } placeholder="关键词"/>
		<button class="btn btn-primary min-w-24" type="submit" data-loading-label="筛选中">@AdminIcon("filter", "size-4", "jargon-filter")<span>筛选</span></button>
	</form>
}
