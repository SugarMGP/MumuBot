package views

import "fmt"

templ KnowledgeWorkspace(data KnowledgeWorkspaceData) {
	<header class="flex items-start justify-between gap-4">
		@PageHeader("长期记忆", "查看已记住的内容和版本历史。", "")
	</header>
	<form class="admin-memory-filters card" method="get" action="/admin/knowledge" hx-get="/admin/knowledge" hx-target="#admin-page-body" hx-swap="outerHTML" hx-push-url="true">
		<input type="hidden" name="sort" value={ data.Filter.Sort }/>
		<input type="hidden" name="order" value={ data.Filter.Order }/>
		if data.Filter.UserID>0 {
			<input type="hidden" name="user_id" value={ fmt.Sprint(data.Filter.UserID) }/>
		}
		<div class="card-body gap-3 p-4">
			<div class="flex flex-wrap items-center gap-3">
				<select class="select w-[clamp(120px,14vw,160px)] border-base-300 focus:border-primary" name="subject_type" aria-label="主体">
					<option value="">全部主体</option>
					for _,subjectType:=range []string{"group","user","self","object"} {
						<option value={ subjectType } selected?={ data.Filter.SubjectType==subjectType }>{ memorySubjectTypeText(subjectType) }</option>
					}
				</select>
				<input class="input min-w-[140px] w-[clamp(140px,18vw,220px)] border-base-300 focus:border-primary" type="search" name="subject_target" aria-label="主体目标" placeholder="群号 / QQ / 事物名" value={ data.Filter.SubjectTarget }/>
				<select class="select w-[clamp(120px,14vw,160px)] border-base-300 focus:border-primary" name="memory_type" aria-label="记忆类型">
					<option value="">全部类型</option>
					for _,memoryType:=range []string{"profile","experience"} {
						<option value={ memoryType } selected?={ data.Filter.MemoryType==memoryType }>{ memoryTypeText(memoryType) }</option>
					}
				</select>
				<input class="input min-w-[180px] flex-1 border-base-300 focus:border-primary" type="search" name="keyword" aria-label="搜索内容" placeholder="搜索内容…" value={ data.Filter.Keyword }/>
				<select class="select w-[clamp(110px,12vw,150px)] border-base-300 focus:border-primary" name="status" aria-label="状态">
					<option value="">全部状态</option>
					for _,status:=range []string{"active","archived"} {
						<option value={ status } selected?={ data.Filter.Status==status }>{ memoryStatusText(status) }</option>
					}
				</select>
				<button class="btn btn-primary ml-auto shrink-0" type="submit">
					@AdminIcon("filter", "size-4", "memory-filter")
					<span>筛选</span>
				</button>
			</div>
		</div>
	</form>
}
