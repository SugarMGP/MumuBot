package views

import "fmt"

templ KnowledgeWorkspace(data KnowledgeWorkspaceData) {
	<header class="flex items-start justify-between gap-4">
		@PageHeader("统一记忆", "查看已记住的内容，核对原文依据。", "")
	</header>
	<form class="admin-memory-filters card" method="get" action="/admin/knowledge" hx-get="/admin/knowledge" hx-target="#admin-page-body" hx-swap="outerHTML" hx-push-url="true">
		<input type="hidden" name="sort" value={ data.Filter.Sort }/>
		<input type="hidden" name="order" value={ data.Filter.Order }/>
		if data.Filter.UserID>0 {
			<input type="hidden" name="user_id" value={ fmt.Sprint(data.Filter.UserID) }/>
		}
		if data.Filter.AuthorID>0 {
			<input type="hidden" name="author_id" value={ fmt.Sprint(data.Filter.AuthorID) }/>
		}
		<div class="card-body gap-3 p-4">
			<div class="flex flex-wrap items-center gap-3">
				<select class="select w-[clamp(150px,20vw,240px)] border-base-300 focus:border-primary" name="conversation" aria-label="会话">
					<option value="">全部会话</option>
					for _,item:=range data.Conversations {
						<option value={ item.Kind+":"+fmt.Sprint(item.TargetID) } selected?={ item.Kind==data.Filter.ConversationKind && item.TargetID==data.Filter.TargetID }>{ conversationLabel(item) }</option>
					}
				</select>
				<input class="input min-w-[200px] flex-1 border-base-300 focus:border-primary" type="search" name="keyword" aria-label="搜索内容" placeholder="搜索内容或术语…" value={ data.Filter.Keyword }/>
				<select class="select w-[clamp(110px,12vw,150px)] border-base-300 focus:border-primary" name="status" aria-label="状态">
					<option value="">全部状态</option>
					for _,status:=range []string{"active","archived"} {
						<option value={ status } selected?={ data.Filter.Status==status }>{ memoryStatusText(status) }</option>
					}
				</select>
				<select class="select w-[clamp(110px,12vw,150px)] border-base-300 focus:border-primary" name="kind" aria-label="类型">
					<option value="">全部类型</option>
					for _,kind:=range []string{"fact","preference","constraint","goal","term","expression","alias"} {
						<option value={ kind } selected?={ data.Filter.Kind==kind }>{ memoryKindText(kind) }</option>
					}
				</select>
				<button class="btn btn-primary ml-auto shrink-0" type="submit">
					@AdminIcon("filter", "size-4", "memory-filter")
					<span>筛选</span>
				</button>
			</div>
			if data.Filter.UserID>0 || data.Filter.AuthorID>0 {
				<div class="mt-3 flex items-center gap-2">
					if data.Filter.UserID>0 {
						<a class="badge badge-soft badge-primary badge-sm" href={ templ.SafeURL(WithQuery(data.CurrentURL, "user_id", "", "page", "1")) } aria-label="清除关于谁筛选">关于 { fmt.Sprint(data.Filter.UserID) } ×</a>
					}
					if data.Filter.AuthorID>0 {
						<a class="badge badge-soft badge-secondary badge-sm" href={ templ.SafeURL(WithQuery(data.CurrentURL, "author_id", "", "page", "1")) } aria-label="清除依据提供人筛选">依据提供人 { fmt.Sprint(data.Filter.AuthorID) } ×</a>
					}
				</div>
			}
		</div>
	</form>
	if data.Note!=nil && data.Note.Note!="" {
		<details class="admin-memory-note">
			<summary class="text-sm">当前群便签 <time class="ml-2 text-xs text-base-content/60">{ formatTime(data.Note.UpdatedAt) }</time></summary>
			<p class="my-3 whitespace-pre-wrap text-sm leading-6">{ data.Note.Note }</p>
			<form method="post" action="/admin/knowledge/actions"><input type="hidden" name="action_kind" value="note-clear"/><input type="hidden" name="group_id" value={ fmt.Sprint(data.Filter.TargetID) }/><input type="hidden" name="return_to" value={ data.CurrentURL }/><button class="btn btn-ghost btn-xs" type="submit">清除便签</button></form>
		</details>
	}
}
