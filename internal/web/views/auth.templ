package views

templ LoginPage(data LoginPageData) {
	<!DOCTYPE html>
	<html lang="zh-CN" data-theme="mumubot">
		@AdminHead("后台登录", nil)
		<body class="font-sans antialiased">
			<main class="relative flex min-h-screen items-center justify-center px-8 py-12">
				<section class="admin-login-card card w-[clamp(320px,26vw,380px)]">
					<div class="card-body items-center gap-5 p-8 text-center">
						<div>
							<h1 class="text-2xl font-semibold text-base-content">MumuBot</h1>
							<p class="mt-1 text-xs text-base-content/60">管理后台</p>
						</div>
						if data.Error != "" {
							<div class="alert alert-error alert-soft w-full py-3 text-left text-sm" role="alert" aria-live="assertive">{ data.Error }</div>
						}
						if data.Enabled {
							<form class="w-full space-y-4" method="post" action="/login">
								<label class="sr-only" for="login-username">用户名</label>
								<input id="login-username" class="sr-only" type="text" name="login_username" value="admin" autocomplete="username" tabindex="-1"/>
								<label class="input w-full border-base-300 bg-base-100 focus-within:border-primary">
									@AdminIcon("lock", "size-4 text-base-content/45", "login-lock")
									<input id="admin-key" class="grow" type="password" name="admin_key" placeholder="输入访问密钥…" autocomplete="current-password" aria-label="访问密钥"/>
									<button class="btn btn-ghost btn-xs" type="button" data-password-target="#admin-key" aria-pressed="false"><span data-password-label>显示</span></button>
								</label>
								<button class="btn btn-primary w-full" type="submit" data-loading-label="登录中">登录</button>
							</form>
						} else {
							<div class="alert alert-warning alert-soft w-full text-left text-sm" role="alert">管理后台当前暂不可用，请稍后再试。</div>
						}
					</div>
				</section>
			</main>
		</body>
	</html>
}

templ DisabledPage() {
	<!DOCTYPE html>
	<html lang="zh-CN" data-theme="mumubot">
		@AdminHead("后台未启用", nil)
		<body class="font-sans antialiased">
			<main class="flex min-h-screen items-center justify-center px-8">
				<section class="admin-login-card card w-[clamp(360px,34vw,460px)]"><div class="card-body items-center text-center"><h1 class="text-2xl font-semibold">管理后台暂不可用</h1><p class="mt-2 text-sm text-base-content/60">当前暂时无法进入后台，请稍后再试。</p></div></section>
			</main>
		</body>
	</html>
}
